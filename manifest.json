{
    "manifest_version": 3,
    "name": "WeVideo (Playposit) ToolKit",
    "version": "3.8",
    "description": "Unified playback accelerator and intelligent interaction toolkit for WeVideo and PlayPosit players.",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "WeVideo (Playposit) ToolKit"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "webNavigation",
        "storage"
    ],
    "options_page": "onboarding.html",
    "host_permissions": [
        "*://*.wevideo.com/*",
        "*://*.playposit.com/*",
        "*://*.playpos.it/*",
        "*://*.instructure.com/*",
        "*://*/*",
        "file:///*"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "inject.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}